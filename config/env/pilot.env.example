# Single-host controlled research runs, not the future API production platform.
# Copy to repository-root .env and supply an approved provider key.
OPENAI_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
TRADINGAGENTS_OUTPUT_LANGUAGE=中文
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_MAX_TOOL_ROUNDS=5
TRADINGAGENTS_LLM_MAX_RETRIES=2
TRADINGAGENTS_MAX_TOKENS=4096
TRADINGAGENTS_CHECKPOINT_ENABLED=true
TRADINGAGENTS_NO_UPDATE_CHECK=1
# Override per operator/experiment. Containers may use /home/appuser/.tradingagents.
# TRADINGAGENTS_RESULTS_DIR=/approved/private/run/logs
# TRADINGAGENTS_CACHE_DIR=/approved/private/run/cache
# TRADINGAGENTS_MEMORY_LOG_PATH=/approved/private/run/memory/trading_memory.md
# SEC_EDGAR_USER_AGENT=Your Organization research-contact@example.com
# Docker host bind mount only; not interpreted by the Python package.
# TRADINGAGENTS_DATA_DIR=./runtime
